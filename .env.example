# Email sending via Resend (https://resend.com)
# Required for contact form and subscribe form to actually deliver emails.
# Sign up, verify your domain (andrewtugume.com), and paste the API key here.
# Set this in Netlify: Site settings → Environment variables
RESEND_API_KEY=re_gkX4o3yp_LTBtx1zXbYJmF5ZrVzbVsxcx

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# Set this in Netlify to enable analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification code
# Found in Search Console → Settings → Ownership verification → HTML tag method
NEXT_PUBLIC_GOOGLE_VERIFICATION_CODE=

# Yandex Webmaster verification code (optional)
NEXT_PUBLIC_YANDEX_VERIFICATION_CODE=
