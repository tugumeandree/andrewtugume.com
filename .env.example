# Copy to .env.local for local development. In production, set these in
# Vercel: Project → Settings → Environment Variables, then redeploy.
# Never commit real values.

# ── Email (Resend, https://resend.com) ──────────────────────
# Required for the contact, booking and sign-up forms to deliver email.
# Verify the andrewtugume.com domain in Resend first.
RESEND_API_KEY=re_your_api_key_here

# Mailing list: the Resend audience new sign-ups are added to (Resend → Audiences).
# Optional — without it, sign-ups are only emailed to Andrew.
RESEND_AUDIENCE_ID=

# ── Analytics and advertising ───────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Ads tag ID (e.g. AW-123456789) and conversion labels from
# Google Ads → Goals → Conversions. Leave empty until campaigns run.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=

# ── Search engine verification ──────────────────────────────
# Google Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_VERIFICATION_CODE=

# Yandex Webmaster (optional)
NEXT_PUBLIC_YANDEX_VERIFICATION_CODE=
