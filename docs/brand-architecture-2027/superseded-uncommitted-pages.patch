+import React from 'react'
+import Image from 'next/image'
+import Link from 'next/link'
+import { brand, roles } from '@/lib/brand'
+
+export default function IdentitySection() {
+  return (
+    <section className="px-4 sm:px-6 lg:px-8 py-16 md:py-24">
+      <div className="max-w-6xl mx-auto grid gap-12 md:grid-cols-[0.9fr_1.1fr] items-center">
+        <div className="relative">
+          <div className="relative aspect-[4/5] rounded-2xl overflow-hidden">
+            <Image src={brand.images.headshot} alt={brand.name} fill className="object-cover" sizes="(min-width: 768px) 45vw, 100vw" />
+          </div>
+          <div className="absolute -bottom-6 left-6 right-6 md:-right-8 md:left-auto md:w-72 rounded-2xl bg-primary p-6 text-white shadow-xl">
+            <p className="text-xs font-semibold tracking-[0.2em] text-accent uppercase">Mission</p>
+            <p className="mt-2 text-sm leading-relaxed text-white/85">{brand.mission}</p>
+          </div>
+        </div>
+
+        <div className="pt-8 md:pt-0">
+          <p className="text-xs font-semibold tracking-[0.2em] text-accent uppercase">Who I Am</p>
+          <h2 className="mt-3 text-3xl md:text-5xl font-semibold text-primary leading-tight">
+            I build people, systems, and capital.
+          </h2>
+          <p className="mt-5 text-base md:text-lg text-gray-700 leading-relaxed">
+            I don’t teach from theory. I’ve founded schools, built technology, and deployed capital — and everything I
+            share on stage, in programs, and in private rooms comes from that work.
+          </p>
+
