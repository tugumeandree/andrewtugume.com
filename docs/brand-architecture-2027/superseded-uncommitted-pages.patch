+
+      <div className="fullbleed">
+        <PageHero
+          eyebrow="Partners & Alliances"
+          title="Building Africa’s future through alliances that last."
+          intro="Andrew works with institutions, companies, and communities that share one mission: to shape the future of work and leadership in Africa through learning, technology, and capital."
+        >
+          <Button asLink href="#partner-with-andrew" variant="accent" size="lg" className="hover:no-underline">Partner with Andrew</Button>
+        </PageHero>
+
+        {/* Founded ecosystem */}
+        <section className="px-4 sm:px-6 lg:px-8 py-16 md:py-20">
+          <div className="max-w-6xl mx-auto">
+            <SectionHeading
+              eyebrow="The Ecosystem"
+              title="Institutions Andrew founded and leads."
+              intro="The organizations that carry the mission into learning, leadership, technology, and capital."
