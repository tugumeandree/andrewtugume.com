+  const activeAlliances = alliances.filter((group) => group.partners.length > 0)
+
+  return (
+    <>
+      <script
+        type="application/ld+json"
+        dangerouslySetInnerHTML={{
+          __html: JSON.stringify(
+            generateBreadcrumbSchema([
+              { name: 'Home', url: 'https://andrewtugume.com' },
+              { name: 'Partners', url: 'https://andrewtugume.com/partners' }
