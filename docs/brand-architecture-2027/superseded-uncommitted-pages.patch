@@ -0,0 +1,36 @@
+import React from 'react'
+import Link from 'next/link'
+import type { Partner } from '@/lib/brand'
+
+export default function PartnerCard({ partner }: { partner: Partner }) {
+  const content = (
+    <>
+      {partner.logo ? (
+        <img src={partner.logo} alt={partner.name} className="h-10 w-auto object-contain" />
+      ) : (
+        <p className="text-lg font-semibold text-primary" style={{ fontFamily: 'Playfair Display, serif' }}>
+          {partner.name}
+        </p>
+      )}
+      <p className="mt-3 text-sm text-gray-700 leading-relaxed">{partner.description}</p>
+      {partner.href && <p className="mt-4 text-xs font-semibold text-accent">Visit →</p>}
+    </>
+  )
+
+  const className = 'block h-full rounded-2xl border border-black/5 bg-white p-6 transition-all hover:border-accent/40 hover:shadow-md hover:no-underline'
+
+  if (!partner.href) {
+    return <div className={className}>{content}</div>
+  }
+
+  const isExternal = partner.href.startsWith('http')
+  return (
+    <Link
+      href={partner.href}
+      className={className}
+      {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
+    >
+      {content}
+    </Link>
+  )
+}
