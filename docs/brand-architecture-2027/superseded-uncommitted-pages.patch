+  title: 'Partners & Alliances',
+  description:
+    'The institutions Andrew Tugume has founded and the strategic partners and alliances he builds with — plus opportunities to partner.',
+  alternates: {
+    canonical: 'https://andrewtugume.com/partners'
+  }
+}
+
