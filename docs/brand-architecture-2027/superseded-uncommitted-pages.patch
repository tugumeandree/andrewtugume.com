+import React from 'react'
+import Link from 'next/link'
+import type { Metadata } from 'next'
+import { generateBreadcrumbSchema } from '@/lib/seo/schema'
+import { getAllPosts } from '@/lib/blog/posts'
+import PageHero from '@/components/PageHero'
+import SectionHeading from '@/components/SectionHeading'
+import SubscribeForm from '@/components/SubscribeForm'
+import { libraryCollections, mediaItems } from '@/lib/brand'
+
+export const metadata: Metadata = {
+  title: 'Library — Essays, Talks, Study Series & Toolkits',
+  description:
+    'Andrew Tugume’s digital library: essays, talks, podcasts, Bible study series, frameworks, and toolkits on work, leadership, technology, and capital.',
+  alternates: {
+    canonical: 'https://andrewtugume.com/library'
+  }
+}
+
+const formatDate = (date: string) =>
+  new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
+
+export default async function Library() {
+  const posts = await getAllPosts()
+
+  return (
+    <>
+      <script
+        type="application/ld+json"
+        dangerouslySetInnerHTML={{
+          __html: JSON.stringify(
+            generateBreadcrumbSchema([
+              { name: 'Home', url: 'https://andrewtugume.com' },
+              { name: 'Library', url: 'https://andrewtugume.com/library' }
+            ])
+          )
+        }}
+      />
+
+      <div className="fullbleed">
+        <PageHero
+          eyebrow="Digital Library"
+          title="Read, watch, and learn with Andrew."
+          intro="Essays, talks, study series, and frameworks on work, leadership, technology, and capital — built from real practice and free to use."
+        />
+
+        {/* Collections */}
+        <section className="px-4 sm:px-6 lg:px-8 py-16 md:py-20">
+          <div className="max-w-6xl mx-auto">
+            <SectionHeading eyebrow="Collections" title="Browse by collection." />
+            <div className="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
+              {libraryCollections.map((collection) => (
+                <Link
+                  key={collection.title}
+                  href={collection.href}
+                  className="flex h-full flex-col rounded-2xl border border-black/5 bg-white p-6 hover:border-accent/40 hover:shadow-md hover:no-underline"
+                >
+                  <p className="text-xs font-semibold tracking-[0.15em] text-accent uppercase">{collection.kicker}</p>
+                  <h3 className="mt-3 text-xl font-semibold text-primary">{collection.title}</h3>
+                  <p className="mt-3 flex-1 text-sm text-gray-700 leading-relaxed">{collection.description}</p>
+                  <p className="mt-5 text-sm font-semibold text-primary">Open →</p>
+                </Link>
+              ))}
+            </div>
+          </div>
+        </section>
+
+        {/* Watch & listen */}
+        <section id="watch" className="bg-primary px-4 sm:px-6 lg:px-8 py-16 md:py-20">
+          <div className="max-w-6xl mx-auto">
+            <SectionHeading
+              tone="dark"
+              eyebrow="Watch & Listen"
+              title="Talks, podcasts, and interviews."
+            />
+            {mediaItems.length > 0 ? (
+              <ul className="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
+                {mediaItems.map((item) => (
+                  <li key={item.href}>
+                    <a
+                      href={item.href}
+                      target="_blank"
+                      rel="noopener noreferrer"
+                      className="block h-full rounded-2xl border border-white/10 bg-white/5 p-6 hover:border-accent hover:no-underline"
+                    >
+                      <p className="text-xs font-semibold tracking-[0.15em] text-accent uppercase">
+                        {item.type} · {item.platform}
+                      </p>
+                      <h3 className="mt-3 text-lg font-semibold text-white">{item.title}</h3>
+                      {item.date && <p className="mt-2 text-xs text-white/50">{formatDate(item.date)}</p>}
+                    </a>
+                  </li>
+                ))}
+              </ul>
+            ) : (
+              <div className="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
+                <p className="max-w-xl text-white/70">
+                  New talks and podcast conversations are on the way. Join the list to get them as they’re released.
+                </p>
+                <SubscribeForm tone="dark" cta="Get updates" />
+              </div>
+            )}
+          </div>
+        </section>
+
+        {/* Essays */}
+        <section id="essays" className="px-4 sm:px-6 lg:px-8 py-16 md:py-20">
+          <div className="max-w-6xl mx-auto">
+            <div className="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
+              <SectionHeading eyebrow="Insights" title="Latest essays." />
+              <Link href="/blog" className="shrink-0 text-sm font-semibold text-primary hover:text-accent">All essays →</Link>
+            </div>
+            {posts.length > 0 ? (
+              <div className="mt-10 grid gap-6 md:grid-cols-2">
+                {posts.slice(0, 6).map((post) => (
+                  <Link
+                    key={post.slug}
+                    href={`/blog/${post.slug}`}
+                    className="block rounded-2xl border border-black/5 bg-white p-6 hover:border-accent/40 hover:no-underline"
+                  >
+                    <p className="text-xs text-gray-500">{formatDate(post.date)}</p>
+                    <h3 className="mt-2 text-xl font-semibold text-primary">{post.title}</h3>
+                    {post.summary && <p className="mt-2 text-sm text-gray-700">{post.summary}</p>}
+                    {post.tags && post.tags.length > 0 && (
+                      <p className="mt-4 text-xs text-gray-500">{post.tags.slice(0, 3).map((tag) => `#${tag}`).join(' ')}</p>
+                    )}
+                  </Link>
+                ))}
+              </div>
+            ) : (
+              <p className="mt-8 text-gray-700">New essays are coming soon.</p>
+            )}
+          </div>
+        </section>
+
+        {/* Subscribe */}
+        <section className="px-4 sm:px-6 lg:px-8 pb-8">
+          <div className="max-w-6xl mx-auto rounded-3xl border border-black/5 bg-white p-8 md:p-12 grid gap-6 md:grid-cols-2 md:items-center">
+            <div>
+              <h2 className="text-3xl font-semibold text-primary">Get new ideas in your inbox.</h2>
+              <p className="mt-3 text-gray-700">Short, high-signal notes on execution, leadership, and capital.</p>
+            </div>
+            <SubscribeForm />
+          </div>
+        </section>
+      </div>
+    </>
+  )
+}
