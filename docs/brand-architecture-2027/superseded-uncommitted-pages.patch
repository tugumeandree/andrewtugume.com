+            </div>
+          </section>
+        ))}
+
+        {/* Partnership types */}
+        <section className="bg-primary px-4 sm:px-6 lg:px-8 py-16 md:py-20">
+          <div className="max-w-6xl mx-auto">
+            <SectionHeading
+              tone="dark"
+              eyebrow="Opportunities"
+              title="Ways to partner."
+              intro="From one-off events to long-term programs, partnerships are designed around shared outcomes."
