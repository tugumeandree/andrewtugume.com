@@ -0,0 +1,53 @@
+import React from 'react'
+import Link from 'next/link'
+import type { Offer } from '@/lib/brand'
+
+const statusLabels = {
+  open: 'Enrolling',
+  waitlist: 'Coming soon',
+  free: 'Free',
+}
+
+export default function OfferCard({ offer }: { offer: Offer }) {
+  const featured = Boolean(offer.badge)
+
+  return (
+    <article
+      className={`relative flex h-full flex-col rounded-2xl p-6 md:p-8 transition-all ${
+        featured
+          ? 'bg-primary text-white ring-1 ring-accent'
+          : 'bg-white border border-black/5 hover:border-accent/40 hover:shadow-md'
+      }`}
+    >
+      <div className="flex items-start justify-between gap-3">
+        <p className="text-xs font-semibold tracking-[0.15em] text-accent uppercase">{offer.kicker}</p>
+        {(offer.badge || offer.status) && (
+          <span
+            className={`shrink-0 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-wide ${
+              featured ? 'bg-accent text-primary' : 'bg-accent/10 text-primary'
+            }`}
+          >
+            {offer.badge || (offer.status && statusLabels[offer.status])}
+          </span>
+        )}
+      </div>
+      <h3 className={`mt-3 text-xl md:text-2xl font-semibold leading-snug ${featured ? 'text-white' : 'text-primary'}`}>
+        {offer.name}
+      </h3>
+      <p className={`mt-3 flex-1 text-sm leading-relaxed ${featured ? 'text-white/75' : 'text-gray-700'}`}>
+        {offer.description}
+      </p>
+      {offer.price && (
+        <p className={`mt-4 text-sm font-semibold ${featured ? 'text-accent' : 'text-primary'}`}>{offer.price}</p>
+      )}
+      <Link
+        href={offer.href}
+        className={`mt-5 inline-flex items-center text-sm font-semibold hover:no-underline ${
+          featured ? 'text-white hover:text-accent' : 'text-primary hover:text-accent'
+        }`}
+      >
+        {offer.cta} →
+      </Link>
+    </article>
+  )
+}
