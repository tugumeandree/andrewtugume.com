+          </div>
+        </section>
+
+        {/* Strategic alliances — groups render once partners are added in src/lib/brand.ts */}
+        {activeAlliances.map((group) => (
+          <section key={group.category} className="bg-white px-4 sm:px-6 lg:px-8 py-16 md:py-20">
+            <div className="max-w-6xl mx-auto">
+              <SectionHeading eyebrow="Alliances" title={group.category} />
+              <div className="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
